# CrisisOS Environment Configuration Template
# Copy this file to .env.local and fill in your project secrets.

# Supabase - Public Client Keys (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - Service Role Key (SERVER ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (SERVER ONLY)
GEMINI_API_KEY=
